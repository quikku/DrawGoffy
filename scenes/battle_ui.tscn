[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/battle_ui.gd" id="1_battle"]

[sub_resource type="Shader" id="Shader_battle_bg"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec2 uv = UV;\n\tfloat cloud = sin(uv.x * 9.0 + sin(uv.y * 7.0)) * 0.5;\n\tcloud += sin(uv.y * 12.0 - uv.x * 3.0) * 0.3;\n\tcloud += sin((uv.x + uv.y) * 19.0) * 0.2;\n\tcloud = cloud * 0.5 + 0.5;\n\tvec3 pale = vec3(0.78, 1.0, 0.96);\n\tvec3 aqua = vec3(0.34, 0.82, 0.74);\n\tvec3 color = mix(pale, aqua, cloud * 0.42);\n\tCOLOR = vec4(color, 1.0);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_battle_bg"]
shader = SubResource("Shader_battle_bg")

